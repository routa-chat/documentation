{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Routa",
  "description": "Documentação oficial da Routa: infraestrutura de mensageria para WhatsApp com uma API REST simples, SDK oficial e webhooks confiáveis.",
  "colors": {
    "primary": "#5B3FD9",
    "light": "#8B72F2",
    "dark": "#5B3FD9"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://routa.chat"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentação",
        "groups": [
          {
            "group": "Comece aqui",
            "pages": [
              "index",
              "quickstart",
              "authentication",
              "environments"
            ]
          },
          {
            "group": "Conceitos",
            "pages": [
              "concepts/data-model",
              "concepts/messages",
              "concepts/events",
              "concepts/templates",
              "concepts/media"
            ]
          },
          {
            "group": "Guias",
            "pages": [
              "guides/send-text-message",
              "guides/send-template-message",
              "guides/receive-messages",
              "guides/track-delivery"
            ]
          },
          {
            "group": "Webhooks",
            "pages": [
              "webhooks/overview",
              "webhooks/signatures",
              "webhooks/retries-and-replay",
              "webhooks/event-types",
              "webhooks/reconciliation"
            ]
          },
          {
            "group": "Confiabilidade",
            "pages": [
              "reliability/idempotency",
              "reliability/rate-limits",
              "reliability/pagination",
              "reliability/delivery-guarantees"
            ]
          },
          {
            "group": "Erros",
            "pages": [
              "errors/overview",
              "errors/error-codes"
            ]
          },
          {
            "group": "Uso e cobrança",
            "pages": [
              "billing/usage",
              "billing/plans-and-quota"
            ]
          }
        ]
      },
      {
        "tab": "Referência da API",
        "groups": [
          {
            "group": "Introdução",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Mensagens",
            "pages": [
              "api-reference/endpoint/messages/send",
              "api-reference/endpoint/messages/list",
              "api-reference/endpoint/messages/retrieve",
              "api-reference/endpoint/messages/mark-read"
            ]
          },
          {
            "group": "Eventos",
            "pages": [
              "api-reference/endpoint/events/list"
            ]
          },
          {
            "group": "Webhooks",
            "pages": [
              "api-reference/endpoint/webhooks/create",
              "api-reference/endpoint/webhooks/list",
              "api-reference/endpoint/webhooks/retrieve",
              "api-reference/endpoint/webhooks/update",
              "api-reference/endpoint/webhooks/rotate-secret",
              "api-reference/endpoint/webhooks/disable",
              "api-reference/endpoint/webhooks/enable",
              "api-reference/endpoint/webhooks/list-deliveries",
              "api-reference/endpoint/webhooks/replay-delivery",
              "api-reference/endpoint/webhooks/replay-deliveries"
            ]
          },
          {
            "group": "Templates",
            "pages": [
              "api-reference/endpoint/templates/create",
              "api-reference/endpoint/templates/list",
              "api-reference/endpoint/templates/retrieve",
              "api-reference/endpoint/templates/upload-media"
            ]
          },
          {
            "group": "Mídia",
            "pages": [
              "api-reference/endpoint/media/upload",
              "api-reference/endpoint/media/retrieve"
            ]
          },
          {
            "group": "Uso",
            "pages": [
              "api-reference/endpoint/usage/retrieve"
            ]
          },
          {
            "group": "Identidade",
            "pages": [
              "api-reference/endpoint/identity/whoami"
            ]
          }
        ]
      },
      {
        "tab": "SDK Node.js",
        "groups": [
          {
            "group": "Comece aqui",
            "pages": [
              "sdk/overview",
              "sdk/configuration"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Suporte",
        "href": "mailto:contato@routa.chat"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Abrir o painel",
      "href": "https://app.routa.chat"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/routa-chat"
    }
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "bash",
        "javascript",
        "python",
        "php",
        "go"
      ],
      "defaults": "required"
    }
  }
